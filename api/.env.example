# Copy to .env and fill in. .env is gitignored; never commit real keys.

PORT=4000
DB_PATH=./data/plots.db

# --- Supabase -----------------------------------------------------------------
# The schema in sql/001_fieldar_schema.sql expects these.
#
# SUPABASE_SECRET_KEY acts as `service_role`: it bypasses every row-level
# security policy in the project. It belongs on the server only - never in the
# Android app, never in the web bundle, never in a chat message or a commit.
# Anything shipped to a client uses SUPABASE_PUBLISHABLE_KEY, which RLS confines
# to reading plots and appending telemetry.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
