# Vercel: set these as Project Environment Variables, not in a committed file.
#
# With both set, the API uses Supabase. With either missing it silently falls
# back to a local SQLite file - fine locally, data loss on a serverless
# deployment, which is why /api/health reports which driver is live.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SECRET_KEY=<service-role / secret key - server only, never shipped to a client>

# Local development only.
PORT=4000
# DB_PATH=./api/data/plots.db
